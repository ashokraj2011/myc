      },
      "type": "REQ"
    },
    {
      "anchor": "[c-hex:REQ-002]",
      "body": "For a positive base-10 whole number greater than zero, the page shall display its mathematically\nequivalent hexadecimal value. *(S1; DOC-002 Q-001, Q-002)*",
      "bodySha256": "563b9ab3ffdc35fbe4360fe1edae1364cf15f84f95b398c1166a6a704f73a421",

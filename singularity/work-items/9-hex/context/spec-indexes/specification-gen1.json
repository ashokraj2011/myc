{
  "clauses": [
    {
      "anchor": "[9-hex:REQ-001]",
      "body": "The hex operator shall convert a valid input in S1 from base 10 to base 16 and display uppercase digits without a prefix. *(S1)*",
      "bodySha256": "00af193f3f0e5b0c7da68628bde8422e423cd3279c446436798a2c46f7bf0aa6",
      "dependsOn": [],
      "id": "9-HEX:REQ-001",

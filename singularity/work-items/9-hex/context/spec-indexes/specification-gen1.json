      "number": 1,
      "source": {
        "line": 310,
        "path": "singularity/work-items/9-hex/artifacts/specification/spec.md"
      },
      "type": "REQ"
    },
    {
      "anchor": "[9-hex:REQ-002]",
      "body": "The operator shall accept only canonical unsigned decimal integer text in the inclusive range 0 through 9007199254740991. *(S1, S2)*",
      "bodySha256": "d39037e0c5c3f658a3717262aa6eef52bca423dc2f912dca798b0dedbfd6e131",
      "dependsOn": [],
      "id": "9-HEX:REQ-002",
      "namespace": "9-HEX",
      "number": 2,
      "source": {

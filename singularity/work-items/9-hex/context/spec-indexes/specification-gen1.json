      },
      "type": "REQ"
    },
    {
      "anchor": "[9-hex:REQ-004]",
      "body": "Implementation verification shall capture and attach a screenshot of the completed feature as evidence; the screenshot is not a visual reference to match. *(S1, S2)*",
      "bodySha256": "d22852cc551696c4c820ae123a11133f505bf41c3f28a9d5b51af05795eec43e",
      "dependsOn": [],
